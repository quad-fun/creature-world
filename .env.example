# --- Model (through Vercel AI Gateway) ---------------------------------
# On Vercel, auth is automatic (OIDC). Locally, create a key at
# https://vercel.com/ai-gateway and put it here, or run `vercel env pull`.
AI_GATEWAY_API_KEY=

# Any Gateway model id works. Cheap defaults:
#   anthropic/claude-haiku-5.5   (default, good voice, ~$0.10 in / $0.50 out per 1M tokens)
#   alibaba/qwen3.7-flash        (cheaper, ~$0.03 in / $0.13 out per 1M tokens)
CREATURE_MODEL=anthropic/claude-haiku-5.5
# Used only for the cost estimate shown on the page (USD per 1M tokens).
MODEL_PRICE_IN=0.10
MODEL_PRICE_OUT=0.50

# "rules" disables all model calls (free, creatures use the rule fallback).
# Leave empty to use the model whenever Gateway credentials exist.
MIND=

# --- World tuning -------------------------------------------------------
TIME_SCALE=20                 # world minutes per real minute
DAILY_CALLS_PER_CREATURE=200  # hard budget per creature per UTC day
MIN_TICK_INTERVAL_S=20        # minimum real seconds between ticks

# --- Storage (optional locally, needed on Vercel) ------------------------
# Add the Upstash Redis integration from the Vercel Marketplace; it sets these.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Cron protection (Vercel sets Authorization automatically) ----------
CRON_SECRET=
